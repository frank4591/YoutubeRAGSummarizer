# Required: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter's free router chooses an available free chat model.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free

# Optional application settings
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=5
REQUEST_TIMEOUT=120
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860
GRADIO_SHARE=false
